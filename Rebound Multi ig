-- =====================================================================
-- HÀM TẢI ÂM THANH CHUẨN TỪ GITHUB (CHỐNG LỖI AUTHORIZED)
-- =====================================================================
local function GitAud(soundlink, filename)
    local url = soundlink
    local FileName = filename
    if not isfile(FileName..".mp3") then
        writefile(FileName..".mp3", game:HttpGet(url))
    end
    return (getcustomasset or getsynasset)(FileName..".mp3")
end

-- Tải trước các âm thanh cho A60ReboundChild
local SoundFarId = GitAud("https://github.com/Cyrene611/Multi-Monster-/raw/refs/heads/main/MultiReboundAmbiance.mp3", "A60_Far")
local SoundRespawnId = GitAud("https://github.com/Cyrene611/Multi-Monster-/raw/refs/heads/main/MultiReboundSpawn.mp3", "A60_Spawn")

-- =====================================================================
-- HÀM DỌN SẠCH CÁC PART / SCRIPT LIÊN QUAN ĐẾN NGƯỜI CHƠI TRONG MODEL & ANCHOR
-- =====================================================================
local function cleanPlayerParts(model)
    local function processInstance(v)
        -- Xóa sạch các Script/LocalScript đi kèm bên trong Model gây hiệu ứng chích điện/sát thương
        if v:IsA("LuaSourceContainer") or v:IsA("Script") or v:IsA("LocalScript") then
            v:Destroy()
        -- Xóa sự kiện va chạm cảm ứng
        elseif v:IsA("TouchInterest") then
            v:Destroy()
        -- Tắt hẳn va chạm vật lý, va chạm cảm ứng với Player và Anchor chống rơi Void
        elseif v:IsA("BasePart") then
            v.CanCollide = false
            v.CanTouch = false
            v.CanQuery = false
            v.Anchored = true
        end
    end

    for _, v in ipairs(model:GetDescendants()) do
        processInstance(v)
    end

    model.DescendantAdded:Connect(processInstance)
end

-- =====================================================================
-- TÁCH RIÊNG: PHÁT ÂM THANH NGAY LẬP TỨC KHI EXECUTE
-- =====================================================================
task.spawn(function()
    -- 🔊 1. Phát sound respawn ngay tức thì vào workspace
    local SoundRespawn = Instance.new("Sound")
    SoundRespawn.Name = "RespawnSound"
    SoundRespawn.SoundId = SoundRespawnId
    SoundRespawn.Volume = 1.56
    SoundRespawn.Parent = workspace
    SoundRespawn:Play()
    game:GetService("Debris"):AddItem(SoundRespawn, 10)

    -- 🔊 2. Lắng nghe workspace để gắn Sound 3D & Dọn dẹp Model khi vừa xuất hiện
    local entityModel = workspace:WaitForChild("A60ReboundChild", 10)
    if entityModel then
        cleanPlayerParts(entityModel) -- Xóa sạch script/part liên quan đến player & Anchor model

        local entityRoot = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart") or entityModel:WaitForChild("HumanoidRootPart", 5)
        if entityRoot then
            local SoundFar = Instance.new("Sound")
            SoundFar.Name = "FarSound"
            SoundFar.SoundId = SoundFarId
            SoundFar.Volume = 2.45
            SoundFar.RollOffMaxDistance = 120
            SoundFar.RollOffMinDistance = 10
            SoundFar.RollOffMode = Enum.RollOffMode.Linear
            SoundFar.Looped = true
            SoundFar.Parent = entityRoot
            SoundFar:Play()
        end
    end
end)

