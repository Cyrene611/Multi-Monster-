-- 2. Đổi màu ColorCorrection (1s vào, 10s ra)
coroutine.wrap(function()
    local tweenService = game:GetService("TweenService")
    
    local currentCC = lighting:FindFirstChild("MainColorCorrection")
    if not currentCC or not currentCC.Parent then
        currentCC = Instance.new("ColorCorrectionEffect")
        currentCC.Name = "MainColorCorrection"
        currentCC.Parent = lighting
    end

    currentCC.Contrast = 0
    currentCC.Saturation = 0
    currentCC.TintColor = Color3.fromRGB(255, 255, 255)

    local fadeInInfo = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local fadeInTween = tweenService:Create(currentCC, fadeInInfo, {
        TintColor = Color3.fromRGB(255, 2, 2),
        Contrast = 0.1,
        Saturation = -0.5
    })
    
    fadeInTween:Play()
    fadeInTween.Completed:Wait()

    if currentCC and currentCC.Parent then
        local fadeOutInfo = TweenInfo.new(10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local fadeOutTween = tweenService:Create(currentCC, fadeOutInfo, {
            TintColor = Color3.fromRGB(255, 255, 255),
            Contrast = 0,
            Saturation = 0
        })
        fadeOutTween:Play()
    end
end)()

-- 3. Đổi màu đèn/neon trong phòng hiện tại
task.spawn(function()
    local Config = {
        TargetColor = Color3.fromRGB(240, 0, 0), 
        TweenTime = 2,                         
    }

    local Workspace = workspace
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService") 
    local LocalPlayer = Players.LocalPlayer
    
    local roomsFolder = Workspace:FindFirstChild("GameplayFolder") and Workspace.GameplayFolder:FindFirstChild("Rooms")
    if not roomsFolder then return end

    local tweenInfo = TweenInfo.new(Config.TweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 10)
    if not rootPart then return end

    local currentRoom = nil

    local touchingParts = Workspace:GetPartsInPart(rootPart)
    for i = 1, #touchingParts do
        local current = touchingParts[i]
        while current and current.Parent do
            if current.Parent == roomsFolder and current:IsA("Model") then
                currentRoom = current
                break
            end
            current = current.Parent
        end
        if currentRoom then break end
    end

    if not currentRoom then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {character}
        local rayResult = Workspace:Raycast(rootPart.Position, Vector3.new(0, -20, 0), raycastParams)
        
        if rayResult and rayResult.Instance then
            local current = rayResult.Instance
            while current and current.Parent do
                if current.Parent == roomsFolder and current:IsA("Model") then
                    currentRoom = current
                    break
                end
                current = current.Parent
            end
        end
    end

    if currentRoom then
        local descendants = currentRoom:GetDescendants()
        for i = 1, #descendants do
            local obj = descendants[i]
            
            if obj:IsA("Light") then
                local path = obj:GetFullName()
                if path:find("%.Lights") or path:find("neon") or path:find("nec") then
                    obj.Enabled = true
                    TweenService:Create(obj, tweenInfo, {Color = Config.TargetColor}):Play() 
                end
            
            elseif obj:IsA("MeshPart") or obj:IsA("BasePart") then
                local nameLower = obj.Name:lower()
                if nameLower == "neon" or nameLower == "smallneon" or nameLower == "nec" then
                    obj.Material = Enum.Material.Neon 
                    TweenService:Create(obj, tweenInfo, {Color = Config.TargetColor}):Play() 
                end
            end
        end
    end
end)

